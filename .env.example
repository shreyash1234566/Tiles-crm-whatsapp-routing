# =============================================================================
# Tiles, Granite & Marble CRM — Example Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in real values for the Tiles, Granite &
# Marble showroom.
#
# DO NOT commit files containing real credentials. Only this `.env.example`
# (with placeholder values) is tracked in git.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# PostgreSQL connection string. Each business vertical points at its OWN
# database so data is fully isolated.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tiles_crm"

# Selects tiles, granite and marble behavior and seed data.
BUSINESS_TYPE="tiles"
NEXT_PUBLIC_BUSINESS_TYPE="tiles"

# Node environment: "development" | "production" | "test"
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Public URLs (exposed to the browser — must be prefixed with NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# Base URL of the app, used for building absolute links (e.g. email tracking).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional public mobile preview (used by `npm run dev:tiles:mobile` or
# `npm run tunnel:tiles`). Keep this value local; never commit a real token.
NGROK_AUTHTOKEN="replace-with-your-ngrok-authtoken"

# WebSocket server URL used by the realtime client.
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# -----------------------------------------------------------------------------
# Auth / Secrets
# -----------------------------------------------------------------------------
# Session signing secret. Use a long random string (>= 32 chars).
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Shared secret for server-to-server CRM API calls (x-api-secret header).
CRM_API_SECRET="replace-with-a-random-secret"

# Secret used to authorize automation/cron endpoints.
CRON_SECRET="replace-with-a-random-secret"
AUTOMATION_CRON_SECRET="replace-with-a-random-secret"

# AES-GCM key (hex) used to encrypt stored WhatsApp credentials.
ENCRYPTION_KEY="replace-with-a-64-char-hex-key"

# -----------------------------------------------------------------------------
# Redis (used by realtime WS server and BullMQ job queues)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# WebSocket server (ws-server/index.js)
# -----------------------------------------------------------------------------
PORT="3001"
CORS_ORIGIN="*"

# -----------------------------------------------------------------------------
# File storage / uploads (local dev or S3/R2-compatible storage)
# -----------------------------------------------------------------------------
# Directory used for local uploads in development.
UPLOAD_DIR="../tiles-crm-uploads"

# -----------------------------------------------------------------------------
# LiveKit (voice/calls)
# -----------------------------------------------------------------------------
LIVEKIT_URL="wss://your-livekit-host"
LIVEKIT_API_KEY="replace-with-livekit-api-key"
LIVEKIT_API_SECRET="replace-with-livekit-api-secret"
LIVEKIT_AGENT_NAME="tiles-crm-agent"
AI_AGENT_NAME="tiles-crm-agent"

# SIP trunk configuration for outbound/inbound calls.
OUTBOUND_SIP_TRUNK_ID="replace-with-sip-trunk-id"
VOBIZ_SIP_DOMAIN="replace-with-sip-domain"
VOBIZ_SIP_TRUNK_ID="replace-with-sip-trunk-id"

# -----------------------------------------------------------------------------
# WhatsApp (Meta Graph API)
# -----------------------------------------------------------------------------
WHATSAPP_GRAPH_API_VERSION="v21.0"
META_APP_SECRET="replace-with-meta-app-secret"

# -----------------------------------------------------------------------------
# Evolution API (WhatsApp Web group routing)
# -----------------------------------------------------------------------------
# Keep these values server-side. Pair the WhatsApp sender through Evolution's
# Manager/connection endpoint, not through the browser client directly.
EVOLUTION_API_URL="https://your-evolution-host"
EVOLUTION_API_KEY="replace-with-evolution-api-key"
EVOLUTION_INSTANCE_NAME="tiles-crm"
EVOLUTION_WEBHOOK_SECRET="replace-with-private-webhook-secret"
# Optional stable public webhook override; otherwise request origin is used.
EVOLUTION_WEBHOOK_URL="https://your-crm-host/api/evolution/webhook"
# Optional single-tenant owner Admin id; otherwise first active Admin is used.
EVOLUTION_OWNER_USER_ID=""
# Comma-separated business names/aliases that raise mention priority.
EVOLUTION_BUSINESS_ALIASES="Tiles CRM,Homzentic,Tiles,Granite,Marble"

# -----------------------------------------------------------------------------
# AI / LLM providers
# -----------------------------------------------------------------------------
GROQ_API_KEY="replace-with-groq-api-key"
GROQ_ROUTING_MODEL="llama-3.1-8b-instant"
ANTHROPIC_API_KEY="replace-with-anthropic-api-key"
ANTHROPIC_ROUTING_MODEL="claude-haiku-4-5-20251001"
# Optional local mock endpoints for sandbox tests; leave empty in production.
GROQ_ROUTING_URL=""
ANTHROPIC_ROUTING_URL=""
GROQ_MODEL="llama-3.3-70b-versatile"
GEMINI_API_KEY="replace-with-gemini-api-key"
GOOGLE_API_KEY="replace-with-google-api-key"
NVIDIA_API_KEY="replace-with-nvidia-api-key"
STABILITY_API_KEY="replace-with-stability-api-key"
SARVAM_API_KEY="replace-with-sarvam-api-key"
