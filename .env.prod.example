# =============================================================================
# .env.prod — Production secrets template
# =============================================================================
# Copy to the VPS deployment directory (NOT inside the git repo):
#   /opt/tiles-crm/.env.prod
#
# Then run:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#     --env-file /opt/tiles-crm/.env.prod up -d
#
# Generate secrets with:   openssl rand -hex 32
# Generate ENCRYPTION_KEY: openssl rand -hex 32   (must be exactly 64 hex chars)
# =============================================================================

# ── Domain ────────────────────────────────────────────────────────────────────
# Must resolve in DNS to this VPS IP BEFORE starting Caddy.
DOMAIN=crm.example.com

# Host ports (must be free on this VPS). The existing furniture CRM uses
# 3000/3001, so this project intentionally uses 4000/4001.
CRM_APP_HOST_PORT=4000
CRM_WS_HOST_PORT=4001

# ── CRM Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=crm
POSTGRES_PASSWORD=REPLACE_strong_password_here
POSTGRES_DB=tiles_crm

# ── CRM Redis ─────────────────────────────────────────────────────────────────
# No password needed — Redis is internal-only (not exposed to internet).
# Uncomment to add auth:  REDIS_PASSWORD=REPLACE_here
REDIS_URL=redis://redis:6379

# ── CRM app secrets ───────────────────────────────────────────────────────────
SESSION_SECRET=REPLACE_64_random_chars
NEXTAUTH_SECRET=REPLACE_64_random_chars
NEXTAUTH_URL=https://crm.example.com
CRM_API_SECRET=REPLACE_32_random_chars
CRON_SECRET=REPLACE_32_random_chars
AUTOMATION_CRON_SECRET=REPLACE_32_random_chars
# 64 hex chars for AES-256-GCM:
ENCRYPTION_KEY=REPLACE_64_hex_chars

# ── Business / vertical ───────────────────────────────────────────────────────
BUSINESS_TYPE=tiles
NEXT_PUBLIC_BUSINESS_TYPE=tiles

# ── Evolution API ─────────────────────────────────────────────────────────────
EVOLUTION_API_KEY=REPLACE_strong_api_key_here
EVOLUTION_INSTANCE_NAME=tiles-crm
EVOLUTION_WEBHOOK_SECRET=REPLACE_32_random_chars
# These are set automatically by docker-compose.prod.yml from DOMAIN:
# EVOLUTION_API_URL=http://evolution:8080
# EVOLUTION_WEBHOOK_URL=https://${DOMAIN}/api/evolution/webhook

# Optional: lock webhook to a specific Admin user ID
EVOLUTION_OWNER_USER_ID=

# Business name aliases for mention-priority matching
EVOLUTION_BUSINESS_ALIASES=Tiles CRM,Homzentic,Tiles,Granite,Marble

# ── Evolution Postgres (separate DB from CRM) ─────────────────────────────────
EVO_PG_USER=evolution
EVO_PG_PASSWORD=REPLACE_strong_evo_db_password
EVO_PG_DB=evolutiondb

# ── Routing LLM ───────────────────────────────────────────────────────────────
# Primary classifier (Groq) — rotate this; the one shared in chat is compromised.
GROQ_API_KEY=REPLACE_new_groq_key
GROQ_ROUTING_MODEL=openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b

# Optional fallback (Anthropic Claude) — only needed for low-confidence escalation.
ANTHROPIC_API_KEY=REPLACE_anthropic_key_or_leave_empty
ANTHROPIC_ROUTING_MODEL=claude-haiku-4-5-20251001

# ── AI / other providers ──────────────────────────────────────────────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
LLM_PROVIDER=groq
AI_AGENT_NAME=anushka

# ── LiveKit / SIP (call centre — only needed with --profile callcentre) ───────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OUTBOUND_SIP_TRUNK_ID=
INBOUND_SIP_TRUNK_ID=
VOBIZ_SIP_TRUNK_ID=
VOBIZ_SIP_DOMAIN=
DEFAULT_TRANSFER_NUMBER=
